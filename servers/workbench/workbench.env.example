# Operator-only file. Do not commit the real token or private installation paths.
PRIMS_WORKBENCH_IMAGE=sha256:REPLACE_WITH_VERIFIED_WORKER_IMAGE_ID
PRIMS_WORKBENCH_TEX_CACHE=/REPLACE/public-tectonic-cache
PRIMS_WORKBENCH_TOKEN_FILE=/REPLACE/private/workbench-token
# Rust app, separately: PRIMS_WORKBENCH_URL=http://127.0.0.1:19340
# Rust app, separately: PRIMS_WORKBENCH_TOKEN=<same private random token>
# Docker broker container: adapt compose.example.yml via a private operator env.
# DOCKER_HOST defaults to the standard local Unix socket; TCP endpoints are rejected.
DOCKER_HOST=unix:///var/run/docker.sock

# Optional fixed public font library and prebuilt fontconfig cache (both or neither).
# These are daemon-visible operator paths; never HTTP/model parameters.
PRIMS_WORKBENCH_FONT_DIR=
PRIMS_WORKBENCH_FONT_CACHE=
# Example operator values, outside source: /REPLACE/public-font-library
# and /REPLACE/public-fontconfig-cache. Both are mounted readonly into workers.
