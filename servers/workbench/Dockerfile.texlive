# Offline, non-root multi-engine TeX worker. Operator supplies public TeX Live
# as a fixed readonly mount, and approved local Tectonic/runner binaries.
ARG BASE_IMAGE=sharelatex/sharelatex:6.0.1
FROM ${BASE_IMAGE}
COPY --chmod=0555 tectonic scribe-tex-runner /usr/local/bin/
COPY --chmod=0555 biber-entrypoint /usr/local/bin/biber
COPY --chmod=0444 worker.py /opt/prims-workbench/worker.py
RUN mkdir -p /workspace /cache /texmf-cache /biber-cache && chown 10001:10001 /workspace && chmod 0555 /opt/prims-workbench
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python3", "-I", "/opt/prims-workbench/worker.py"]
