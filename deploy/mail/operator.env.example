# Trusted operator-only configuration. Copy outside the repository, protect mode 0600.
# Set the same HTTPS origin in the app's private app.env; no IDN domain for Outlook OAuth.
PRIMS_PUBLIC_URL=https://prims.example.com
PRIMS_MAIL_DEPLOYMENT_DIR=/etc/prims/mail
# Fixed loopback endpoints; never a public/remote URL.
PRIMS_AUTH_HEALTH_URL=http://127.0.0.1:19999/health
PRIMS_APP_HOOK_URL=http://127.0.0.1:13010/api/mail/outlook/hook
# Operator-controlled Docker endpoint; never accepted from HTTP input.
PRIMS_DOCKER_HOST=unix:///var/run/docker.sock
